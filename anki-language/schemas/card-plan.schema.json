{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/portoduque/anki-language-workflow/anki-language/schemas/card-plan.schema.json",
  "title": "Anki Language Card Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target_language",
    "base_language",
    "deck_name",
    "cards"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "target_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "pattern": "\\S"
        }
      }
    },
    "base_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "code": {
          "type": "string",
          "minLength": 2,
          "pattern": "\\S"
        }
      }
    },
    "deck_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill",
          "target_text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "skill": {
            "enum": [
              "reading",
              "listening",
              "production",
              "pronunciation",
              "writing"
            ]
          },
          "mode": {
            "enum": [
              "standard",
              "minimal-pair",
              "sound-discrimination",
              "spelling-sound",
              "audio-to-spelling"
            ],
            "default": "standard"
          },
          "target_text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "writing_answer": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Writing only: exact unique word or short chunk to type, occurring once within target_text. Other sentence text remains visible."
          },
          "base_text": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "ipa": {
            "type": "string"
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "audio_clip": {
            "type": "object",
            "description": "Trim the original recording to the target utterance before delivery. Use verified bounds when available; otherwise word-alignment is optional and may fail closed.",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "start_seconds": {
                "type": "number",
                "minimum": 0
              },
              "end_seconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "dependentRequired": {
              "start_seconds": [
                "end_seconds"
              ],
              "end_seconds": [
                "start_seconds"
              ]
            }
          },
          "audio_transcript": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Optional verified transcript of the actual recording, required if one audio file is reused across cards with different target texts."
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "source_excerpt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Optional exact original-language wording transcribed from the supplied source. The card target must occur as a whole phrase within this verified excerpt; do not use for generated paraphrases."
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "audio_provenance": {
            "$ref": "#/$defs/mediaProvenance"
          },
          "image_provenance": {
            "$ref": "#/$defs/mediaProvenance"
          },
          "audio_request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "text"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "auto",
                  "tts"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "auto",
                  "piper"
                ],
                "default": "auto"
              },
              "voice": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "image_request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "query"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "auto",
                  "search"
                ]
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "auto",
                  "openverse",
                  "wikimedia"
                ],
                "default": "auto"
              },
              "licenses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "media_validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "audio": {
                "$ref": "#/$defs/mediaValidation"
              },
              "image": {
                "$ref": "#/$defs/mediaValidation"
              }
            }
          },
          "media_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "error"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "audio",
                    "image"
                  ]
                },
                "provider": {
                  "type": "string"
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reading": {
            "type": "string",
            "description": "Optional target-language reading/romanization/script-reading aid."
          },
          "variant": {
            "type": "string",
            "description": "Optional alternate written/script/orthographic form."
          },
          "grammar": {
            "type": "string",
            "description": "Optional concise grammatical attribute such as gender, noun class, part of speech, or form."
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "apkg",
            "live",
            "both"
          ],
          "default": "apkg"
        }
      }
    }
  },
  "$defs": {
    "mediaProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user-supplied",
            "native-source",
            "tts",
            "generated",
            "licensed",
            "unknown"
          ]
        },
        "provider": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alignment": {
          "enum": [
            "verified-timestamps",
            "asr-exact"
          ]
        }
      }
    },
    "mediaValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator"
      ],
      "properties": {
        "status": {
          "const": "valid"
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
