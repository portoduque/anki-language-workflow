{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/portoduque/anki-language-workflow/anki-language/schemas/card-plan.schema.json",
  "title": "Anki Language Card Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target_language",
    "base_language",
    "deck_name",
    "cards"
  ],
  "properties": {
    "version": {
      "const": "2.0"
    },
    "target_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "base_language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "code"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "deck_name": {
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "skill",
          "target_text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "skill": {
            "enum": [
              "reading",
              "listening",
              "production",
              "pronunciation"
            ]
          },
          "mode": {
            "type": "string",
            "minLength": 1,
            "default": "standard"
          },
          "target_text": {
            "type": "string",
            "minLength": 1
          },
          "base_text": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "focus": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "ipa": {
            "type": "string"
          },
          "audio": {
            "type": "string",
            "minLength": 1
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "audio_provenance": {
            "$ref": "#/$defs/mediaProvenance"
          },
          "image_provenance": {
            "$ref": "#/$defs/mediaProvenance"
          },
          "audio_request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "text"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "auto",
                  "tts"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "auto",
                  "piper"
                ],
                "default": "auto"
              },
              "voice": {
                "type": "string",
                "minLength": 1
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "image_request": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "query"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "auto",
                  "search"
                ]
              },
              "query": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "enum": [
                  "auto",
                  "openverse",
                  "wikimedia"
                ],
                "default": "auto"
              },
              "licenses": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "required": {
                "type": "boolean"
              }
            }
          },
          "media_validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "audio": {
                "$ref": "#/$defs/mediaValidation"
              },
              "image": {
                "$ref": "#/$defs/mediaValidation"
              }
            }
          },
          "media_issues": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "error"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "audio",
                    "image"
                  ]
                },
                "provider": {
                  "type": "string"
                },
                "error": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "apkg",
            "live",
            "both"
          ],
          "default": "apkg"
        }
      }
    }
  },
  "$defs": {
    "mediaProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user-supplied",
            "native-source",
            "tts",
            "generated",
            "licensed",
            "unknown"
          ]
        },
        "provider": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        }
      }
    },
    "mediaValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "validator"
      ],
      "properties": {
        "status": {
          "const": "valid"
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
